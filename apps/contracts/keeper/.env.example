# ── Required ──────────────────────────────────────────────────────────────────

# Celo mainnet RPC (public forno or your own node)
RPC_URL=https://forno.celo.org

# Deployed DripV4 contract address on Celo mainnet
DRIP_V4_ADDR=0x75d5e1bDb93dB238DFD56e183784a6F7386c05E8

# Private key of the keeper wallet
# This wallet needs CELO for gas — ~0.5 CELO is plenty for months of operation
# A dedicated throwaway wallet is recommended (not the deployer key)
PRIVATE_KEY=0x...

# ── Optional ───────────────────────────────────────────────────────────────────

# Fallback polling interval in milliseconds (default: 30000 = 30s)
# Precision timers fire at exact endTime — this is just the safety net
POLL_INTERVAL_MS=30000

# Block number when DripV4 was deployed
# The keeper uses streamCount+getStream for backfill, but if you use event
# scanning mode this avoids scanning from genesis (very slow).
# DripV4 Celo mainnet deploy block: ~69600000
START_BLOCK=69600000

# ── Health & Alerting ───────────────────────────────────────────────────────────

# Port for the HTTP health endpoint (GET /health returns JSON)
# Used by UptimeRobot, BetterStack, or any uptime monitor
HEALTH_PORT=3001

# Telegram bot token + chat ID for dead-man alerts
# Create a bot via @BotFather, add it to a chat/group, get the chat ID with @getidsbot
TG_BOT_TOKEN=
TG_CHAT_ID=

# Alert if no new block has been seen for this many minutes (default: 10)
DEADMAN_MINUTES=10
