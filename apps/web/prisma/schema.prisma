// Prisma schema for leaderboard & indexer state

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserStats {
  address            String   @id
  streamsCreated     Int      @default(0)
  withdrawalsClaimed Int      @default(0)
  totalDeposited     Decimal  @default(0)
  totalWithdrawn     Decimal  @default(0)
  points             Decimal  @default(0)
  
  // UBI tracking fields
  ubiClaimCount      Int      @default(0)  // Total number of UBI claims
  totalUbiClaimed    Decimal  @default(0)  // Total G$ claimed from UBI
  lastUbiClaim       DateTime? // Last UBI claim timestamp
  
  updatedAt          DateTime @updatedAt
}

model IndexerState {
  id                Int    @id @default(1)
  lastProcessedBlock BigInt @default(0)
}

model SelfVerification {
  address       String   @id // User wallet address
  isVerified    Boolean  @default(false)
  proofId       String?  // Self Protocol proof ID
  verifiedAt    DateTime?
  sessionId     String?  // Session ID used for verification
  disclosures   Json?    // Stored disclosure data (date of birth, etc.)
  metadata      Json?    // Additional verification metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isVerified])
  @@index([verifiedAt])
}

model UbiClaim {
  id              String   @id @default(cuid())
  address         String   // User wallet address
  amount          Decimal  // Amount claimed (in G$)
  amountWei       String   // Raw amount in wei (for precision)
  transactionHash String?  // Transaction hash
  claimedAt       DateTime @default(now())
  chainId         Int      // Network (42220 for Celo mainnet)
  
  @@index([address])
  @@index([claimedAt])
  @@index([chainId])
}

