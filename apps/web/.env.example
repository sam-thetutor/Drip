# Self Protocol Configuration
# The endpoint MUST be a full, publicly accessible HTTPS URL
# For local development, use a tool like ngrok to expose your local server
# For production, use your deployed Vercel URL
NEXT_PUBLIC_SELF_APP_NAME="Drip - Programmable Payments"
NEXT_PUBLIC_SELF_SCOPE="drip-payments"
NEXT_PUBLIC_SELF_ENDPOINT="https://your-domain.com/api/self/verify"

# Optional: Your app's public URL (used if endpoint is relative)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Server-side only (add to .env.local, not committed)
# SELF_VERIFICATION_SECRET="your-verification-secret"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side only
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Celo SocialConnect phone lookup (server-side only)
# Use a funded key for ODIS lookup auth/quota.
CELO_LOOKUP_PRIVATE_KEY="0xyour_private_key_here"
# FederatedAttestations contract address (set per network)
CELO_FEDERATED_ATTESTATIONS_ADDRESS="0xyour_federated_attestations_address"
# Comma-separated trusted issuer addresses (mainnet defaults)
CELO_TRUSTED_ISSUERS="0x6549aF2688e07907C1b821cA44d6d65872737f05,0x388612590F8cC6577F19c9b61811475Aa432CB44"
# mainnet | alfajores
CELO_NETWORK="mainnet"


# Privy auth (https://dashboard.privy.io) — enable Email + Google + external wallets
NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
