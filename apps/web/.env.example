# Self Protocol Configuration
# The endpoint MUST be a full, publicly accessible HTTPS URL
# For local development, use a tool like ngrok to expose your local server
# For production, use your deployed Vercel URL
NEXT_PUBLIC_SELF_APP_NAME="Drip - Programmable Payments"
NEXT_PUBLIC_SELF_SCOPE="drip-payments"
NEXT_PUBLIC_SELF_ENDPOINT="https://your-domain.com/api/self/verify"

# Optional: Your app's public URL (used if endpoint is relative)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Server-side only (add to .env.local, not committed)
# SELF_VERIFICATION_SECRET="your-verification-secret"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side only
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

